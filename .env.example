# Copy to .env and fill in. Every value is checked at startup (libs/common/src/config/env.schema.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://booking:booking@localhost:5433/booking
REDIS_URL=redis://localhost:6380

# --- API keys (x-api-key) ---
API_KEY_ENV=test
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=change-me-change-me-change-me-change-me

# --- Other-service JWT (every call) ---
SERVICE_AUTH_HEADER=authorization
SERVICE_AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
SERVICE_AUTH_ISSUER=https://issuer.example.com/
SERVICE_AUTH_AUDIENCE=booking-service
SERVICE_AUTH_ALGORITHMS=RS256,ES256
SERVICE_AUTH_CLOCK_SKEW_S=30
# Optional: claim that must equal api_clients.tenant
SERVICE_AUTH_TENANT_CLAIM=
# Optional extra hosts the JWT may be forwarded to (comma separated). The Contact host is added automatically.
DOWNSTREAM_ALLOWLIST=

# --- Contact system ---
CONTACT_API_BASE_URL=https://contacts.example.com
CONTACT_API_CONTACT_PATH=/v1/me/contact
CONTACT_API_TIMEOUT_MS=3000
CONTACT_API_RETRIES=1

# --- Reservation status webhook (reservation.confirmed + reservation.failed) ---
RESERVATION_WEBHOOK_URL=https://hooks.example.com/booking-reservations
RESERVATION_WEBHOOK_SECRET=change-me-change-me-change-me-change-me
RESERVATION_WEBHOOK_TIMEOUT_MS=5000
RESERVATION_WEBHOOK_MAX_ATTEMPTS=8

# --- Internal secrets (32+ chars each; JOB_ENCRYPTION_KEY is 32 bytes, base64) ---
SLOT_TOKEN_SECRET=change-me-change-me-change-me-change-me
USER_REF_SECRET=change-me-change-me-change-me-change-me
JOB_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Tuning ---
SHIFTS_CACHE_TTL_S=120
SHIFTS_TIMEOUT_MS=25000
SUBMIT_CONCURRENCY=2
MAX_BOOKING_ATTEMPTS=3

# --- Dev only: make the fake provider fail every booking with this code (e.g. PLATFORM_BLOCKED) ---
FAKE_PROVIDER_FAIL_CODE=
